PORT=4000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=agileboard
CORS_ORIGIN=http://localhost:5173
# true when the app is served over HTTPS (production): the sign-in cookie is then sent only over HTTPS
COOKIE_SECURE=false

# Jira Cloud (create a token at https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_BASE_URL=https://polussolutions.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Optional: closed sprints to sync per board (active sprints are always synced).
# Every sprint since JIRA_SYNC_SINCE is synced, and at least the latest JIRA_SYNC_CLOSED_SPRINTS.
JIRA_SYNC_CLOSED_SPRINTS=6
# Default: 1 April, the start of the current Indian financial year
JIRA_SYNC_SINCE=
# Optional overrides; detected automatically when empty
JIRA_SPRINT_FIELD=
JIRA_STORY_POINTS_FIELD=
# Optional: timezone for sprint start/end dates (e.g. Asia/Kolkata). Default: the syncing Jira account's timezone
JIRA_TIMEZONE=

# Optional: sign users out after this many hours without activity (default 6)
SESSION_IDLE_HOURS=

# Optional: Jira label that marks issues as part of the sprint goal (default sprint-goal)
SPRINT_GOAL_LABEL=

# Email for sync notifications (Workspace Settings → General). The password stays here, never in the app.
# SMTP_HOST=log prints emails to the server log instead of sending (for testing).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Link to the dashboard in emails, e.g. https://agilemetrix.example.com
APP_URL=
# Set to off to disable the scheduled sync scheduler on this server
SCHEDULER=

# Redmine (Settings → Integrations → Redmine): time entries for Resource Management
REDMINE_URL=
REDMINE_API_KEY=
# Import time entries from this date (default: 1 April, start of the financial year)
REDMINE_SYNC_SINCE=
